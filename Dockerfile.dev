# Development Dockerfile for zuno-marketplace-indexer (Ponder).
# Used by the opt-in `app` service in docker-compose.yml.

FROM node:20-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

COPY package.json ./
RUN pnpm install --no-frozen-lockfile

COPY . .

EXPOSE 42069

CMD ["pnpm", "dev"]
