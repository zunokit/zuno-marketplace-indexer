# ============================================================================
# Zuno Marketplace Indexer - Environment Configuration
# Only includes variables actually used in the code
# ============================================================================

# Required - Zuno API for fetching ABIs and contract info
ZUNO_API_URL=https://zuno-marketplace-abis.vercel.app/api
ZUNO_API_KEY=your_zuno_api_key_here

# Required - Blockchain RPC URLs (at least one chain required)
# Format: PONDER_RPC_URL_{CHAIN_ID}
PONDER_RPC_URL_31337=http://127.0.0.1:8545

# Optional - External PostgreSQL (if not set, uses embedded PGlite)
# DATABASE_URL=postgresql://user:password@localhost:5432/ponder

# Optional - API Security (if not set, API is public)
# BEARER_TOKEN=your_secret_bearer_token
# API_KEY=your_secret_api_key

# Optional - CORS (default: *)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional - Rate Limiting (default: 100 requests per 60 seconds)
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Optional - Logging (development only)
# NODE_ENV=development
# VERBOSE_LOGGING=true
# DETAILED_LOGGING=true
